DB_URL=jdbc:postgresql://localhost:5432/gestopago
DB_USERNAME=postgres
DB_PASSWORD=
APP_JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
APP_JWT_EXPIRATION_MS=7200000

GESTOPAGO_AUTH_URL=https://gestopago.portalventas.net
GESTOPAGO_CATALOG_URL=https://gestopago.portalventas.net
GESTOPAGO_AUTH_REFRESH_RATE_MS=86400000
GESTOPAGO_AUTH_RENEWAL_CHECK_MS=60000
GESTOPAGO_AUTH_CONNECT_TIMEOUT_MS=5000
GESTOPAGO_AUTH_READ_TIMEOUT_MS=10000
GESTOPAGO_CATALOG_PATH=/sistema/service/getProductList.do
GESTOPAGO_CATALOG_CONNECT_TIMEOUT_MS=5000
GESTOPAGO_CATALOG_READ_TIMEOUT_MS=15000

REDIS_HOST=localhost
REDIS_PORT=6379
# Redis gestionado (Railway, etc.) exige contraseña; vacía = sin autenticación (Redis local).
REDIS_PASSWORD=
REDIS_CATALOGO_CACHE_TTL=24h
GESTOPAGO_CATALOG_SYNC_CRON="0 0 3 * * *"
GESTOPAGO_CATALOG_SYNC_ZONE=America/Mexico_City
GESTOPAGO_AUTH_ID_DISTRIBUIDOR=
GESTOPAGO_AUTH_CODIGO_DISPOSITIVO=
GESTOPAGO_AUTH_PASSWORD=
# Llave AES-256 (32 bytes en Base64) para cifrar en la BD el token de GestoPago Y los secretos 2FA de los usuarios.
# Generar con: openssl rand -base64 32. NO la cambies después: sin ella no se pueden descifrar los secretos 2FA
# y nadie podría iniciar sesión (habría que reiniciar el enlace de todos; ver README).
GESTOPAGO_TOKEN_KEY=

GESTOPAGO_AUTH_RENEWAL_CRON="0 0 0 * * *"
GESTOPAGO_PAGOS_URL=https://gestopago.portalventas.net
GESTOPAGO_PAGOS_PATH=/sistema/service/sendTx.do
# Llave AES-256 (32 bytes) e IV (16 bytes) en Base64, proporcionados por GestoPago.
GESTOPAGO_PAGOS_SECRET_KEY=
GESTOPAGO_PAGOS_IV=
GESTOPAGO_PAGOS_PARAMETRO_FIRMA=signed
GESTOPAGO_PAGOS_UNIDAD=Sucursal Matriz
GESTOPAGO_PAGOS_READ_TIMEOUT_MS=70000
GESTOPAGO_PAGOS_API_KEY=
GESTOPAGO_PAGOS_CONCILIACION_MS=60000
GESTOPAGO_PAGOS_LIMITE_POR_MINUTO=5

# Segundo factor (2FA): código TOTP de una app autenticadora (Google Authenticator, Microsoft Authenticator, Authy).
# No necesita variables propias: el secreto de cada usuario se guarda cifrado con GESTOPAGO_TOKEN_KEY.
# Orígenes (app web) autorizados por CORS, separados por coma.
CORS_ORIGENES=http://localhost:*,http://127.0.0.1:*
# Swagger UI apagado por omisión; activar solo en desarrollo.
SWAGGER_ENABLED=false
# Detrás de un proxy inverso (Railway, nginx, balanceador): native, para que los límites por IP usen la IP real.
# Sin esto, en Railway todos los usuarios compartirían la IP del proxy. En local déjalo en none.
FORWARD_HEADERS=none
# Límites por minuto sobre todas las rutas (por IP, por usuario y ráfaga en login/registro); opcionales.
# LIMITE_GLOBAL_POR_IP=120
# LIMITE_GLOBAL_POR_USUARIO=120
# LIMITE_RAFAGA_PUBLICA_POR_IP=20
