DB_URL=jdbc:postgresql://localhost:5432/gestopago
DB_USERNAME=postgres
DB_PASSWORD=
APP_JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
APP_JWT_EXPIRATION_MS=28800000

GESTOPAGO_AUTH_URL=https://gestopago.portalventas.net
GESTOPAGO_CATALOG_URL=https://gestopago.portalventas.net
GESTOPAGO_AUTH_REFRESH_RATE_MS=86400000
GESTOPAGO_AUTH_RENEWAL_CHECK_MS=60000
GESTOPAGO_AUTH_CONNECT_TIMEOUT_MS=5000
GESTOPAGO_AUTH_READ_TIMEOUT_MS=10000
GESTOPAGO_CATALOG_PATH=/sistema/service/getProductList.do
GESTOPAGO_CATALOG_CONNECT_TIMEOUT_MS=5000
GESTOPAGO_CATALOG_READ_TIMEOUT_MS=15000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CATALOGO_CACHE_TTL=24h
GESTOPAGO_CATALOG_SYNC_CRON="0 0 3 * * *"
GESTOPAGO_CATALOG_SYNC_ZONE=America/Mexico_City
GESTOPAGO_AUTH_ID_DISTRIBUIDOR=
GESTOPAGO_AUTH_CODIGO_DISPOSITIVO=
GESTOPAGO_AUTH_PASSWORD=
# Llave AES-256 (32 bytes en Base64) para cifrar el token de GestoPago en la BD. Generar con: openssl rand -base64 32
GESTOPAGO_TOKEN_KEY=

GESTOPAGO_AUTH_RENEWAL_CRON="0 0 0 * * *"
GESTOPAGO_PAGOS_URL=https://gestopago.portalventas.net
GESTOPAGO_PAGOS_PATH=/sistema/service/sendTx.do
# Llave AES-256 (32 bytes) e IV (16 bytes) en Base64, proporcionados por GestoPago.
GESTOPAGO_PAGOS_SECRET_KEY=
GESTOPAGO_PAGOS_IV=
GESTOPAGO_PAGOS_PARAMETRO_FIRMA=signed
GESTOPAGO_PAGOS_UNIDAD=Sucursal Matriz
GESTOPAGO_PAGOS_READ_TIMEOUT_MS=70000
GESTOPAGO_PAGOS_API_KEY=
GESTOPAGO_PAGOS_CONCILIACION_MS=60000
GESTOPAGO_PAGOS_LIMITE_POR_MINUTO=5
